@@ -392,3 +392,16 @@ copyout(pde_t *pgdir, uint va, void *p, uint len)
 //PAGEBREAK!
 // Blank page.
 
+
+// Lab 8, Q2: count the pages one address space spends on its own page
+// tables: the page directory itself plus every present page table page.
+int
+countpagetables(pde_t *pgdir)
+{
+  int i, n = 1;
+
+  for(i = 0; i < NPDENTRIES; i++)
+    if(pgdir[i] & PTE_P)
+      n++;
+  return n;
+}
