diff --git a/sysproc.c b/sysproc.c
index 5079ef7..343b761 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -6,6 +6,7 @@
 #include "memlayout.h"
 #include "mmu.h"
 #include "proc.h"
+#include "meminfo.h"
 
 int
 sys_fork(void)
@@ -112,3 +113,23 @@ sys_va2pa(void)
           (*pte & PTE_P) != 0, (*pte & PTE_W) != 0, (*pte & PTE_U) != 0);
   return (int)(PTE_ADDR(*pte) | ((uint)va & 0xfff));
 }
+
+// Lab 8, Q2: fill a struct meminfo for the calling process. Counts come
+// from the kalloc free counter and the caller's own page directory.
+int
+sys_getmeminfo(void)
+{
+  struct meminfo *umi;
+  struct meminfo kmi;
+  struct proc *p = myproc();
+
+  if(argptr(0, (char**)&umi, sizeof(*umi)) < 0)
+    return -1;
+  kmi.total_pages = PHYSTOP / PGSIZE;
+  kmi.free_pages = freepagecount();
+  kmi.user_pages = p->sz / PGSIZE;
+  kmi.pagetable_pages = countpagetables(p->pgdir);
+  if(copyout(p->pgdir, (uint)umi, &kmi, sizeof(kmi)) < 0)
+    return -1;
+  return 0;
+}
