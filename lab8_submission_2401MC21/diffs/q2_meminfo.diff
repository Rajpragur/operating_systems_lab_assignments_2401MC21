diff --git a/kalloc.c b/kalloc.c
index 14cd4f4..7bc7459 100644
--- a/kalloc.c
+++ b/kalloc.c
@@ -21,6 +21,7 @@ struct {
   struct spinlock lock;
   int use_lock;
   struct run *freelist;
+  int freecount;  // Lab 8, Q2: pages currently on the free list
 } kmem;
 
 // Initialization happens in two phases.
@@ -72,6 +73,7 @@ kfree(char *v)
   r = (struct run*)v;
   r->next = kmem.freelist;
   kmem.freelist = r;
+  kmem.freecount++;
   if(kmem.use_lock)
     release(&kmem.lock);
 }
@@ -87,10 +89,28 @@ kalloc(void)
   if(kmem.use_lock)
     acquire(&kmem.lock);
   r = kmem.freelist;
-  if(r)
+  if(r){
     kmem.freelist = r->next;
+    kmem.freecount--;
+  }
   if(kmem.use_lock)
     release(&kmem.lock);
   return (char*)r;
 }
 
+
+// Lab 8, Q2: read the free page count maintained by kalloc/kfree above.
+// The counter itself is updated while kmem.lock is held (or before locks
+// are enabled during kinit), so a plain read under the lock is exact.
+int
+freepagecount(void)
+{
+  int n;
+
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  n = kmem.freecount;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+  return n;
+}
diff --git a/meminfo.h b/meminfo.h
new file mode 100644
index 0000000..c9b5425
--- /dev/null
+++ b/meminfo.h
@@ -0,0 +1,13 @@
+#ifndef MEMINFO_H
+#define MEMINFO_H
+
+// Lab 8, Q2: filled in by the getmeminfo system call. All counts are in
+// 4 KB pages. Shared by the kernel (sysproc.c) and user programs (user.h).
+struct meminfo {
+  int total_pages;      // physical pages managed by kalloc (PHYSTOP / PGSIZE)
+  int free_pages;       // pages currently on the kalloc free list
+  int user_pages;       // pages in the caller's address space (sz / PGSIZE)
+  int pagetable_pages;  // pages the caller's page tables use, directory included
+};
+
+#endif
diff --git a/memtest.c b/memtest.c
new file mode 100644
index 0000000..5df5168
--- /dev/null
+++ b/memtest.c
@@ -0,0 +1,63 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+// Q2 (Lab 8): print physical memory statistics with getmeminfo, grow the
+// heap, fork, and check that free pages come back when the child exits.
+
+static void
+printstats(const char *tag, struct meminfo *save)
+{
+  struct meminfo mi;
+
+  if(getmeminfo(&mi) < 0){
+    printf(1, "memtest: getmeminfo failed\n");
+    return;
+  }
+  printf(1, "%s: total %d free %d user %d pagetable %d\n",
+         tag, mi.total_pages, mi.free_pages, mi.user_pages,
+         mi.pagetable_pages);
+  if(save)
+    *save = mi;
+}
+
+int
+main(void)
+{
+  char *base;
+  int i, pid;
+  struct meminfo mid, end;
+
+  printf(1, "memtest: physical memory statistics (pages of 4 KB)\n");
+  printstats("start", 0);
+
+  base = sbrk(16 * 4096);
+  if(base == (char*)-1){
+    printf(1, "memtest: sbrk failed\n");
+    exit();
+  }
+  // Touch every page so the frames are really handed out.
+  for(i = 0; i < 16; i++)
+    base[i * 4096] = (char)i;
+  printstats("after sbrk(16 pages) and touch", &mid);
+
+  pid = fork();
+  if(pid < 0){
+    printf(1, "memtest: fork failed\n");
+    exit();
+  }
+  if(pid == 0){
+    printstats("child after fork", 0);
+    exit();
+  }
+  wait();
+  printstats("after child exit", &end);
+
+  if(end.free_pages == mid.free_pages)
+    printf(1, "memtest: no leak - free pages back to %d after child exit\n",
+           end.free_pages);
+  else
+    printf(1, "memtest: LEAK? free %d after child exit, expected %d\n",
+           end.free_pages, mid.free_pages);
+  exit();
+}
