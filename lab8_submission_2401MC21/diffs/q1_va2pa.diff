diff --git a/sysproc.c b/sysproc.c
index 0686d29..5079ef7 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,26 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// Q1 (Lab 8): translate a virtual address of the calling process to its
+// physical address by walking the process page table. Returns -1 when the
+// page is not present or is not user accessible. The kernel prints the
+// two-level split of the address and the PTE flag bits for each successful
+// translation.
+int
+sys_va2pa(void)
+{
+  int va;
+  pte_t *pte;
+  struct proc *p = myproc();
+
+  if(argint(0, &va) < 0)
+    return -1;
+  pte = walkpgdir(p->pgdir, (void*)va, 0);
+  if(pte == 0 || (*pte & PTE_P) == 0 || (*pte & PTE_U) == 0)
+    return -1;
+  cprintf("va2pa: va 0x%x pdx %d ptx %d offset 0x%x flags P=%d W=%d U=%d\n",
+          va, PDX(va), PTX(va), va & 0xfff,
+          (*pte & PTE_P) != 0, (*pte & PTE_W) != 0, (*pte & PTE_U) != 0);
+  return (int)(PTE_ADDR(*pte) | ((uint)va & 0xfff));
+}
