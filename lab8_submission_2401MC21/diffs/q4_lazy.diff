   return 0;
 }
+
+// Lab 8, Q4: allocate one zeroed frame and map it at va (page aligned
+// here) with user read/write permission. Used when a lazily grown heap
+// page is touched for the first time. Returns 0 on success, -1 when no
+// frame is available or the mapping cannot be installed.
+int
+lazyalloc(pde_t *pgdir, uint va)
+{
+  char *mem;
+  pte_t *pte;
+
+  va = PGROUNDDOWN(va);
+  pte = walkpgdir(pgdir, (char*)va, 1);
+  if(pte == 0)
+    return -1;
+  if(*pte & PTE_P)
+    return 0;
+  mem = kalloc();
+  if(mem == 0)
+    return -1;
+  memset(mem, 0, PGSIZE);
+  if(mappages(pgdir, (char*)va, PGSIZE, V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
+  return 0;
+}
+
+// Lab 8, Q4: page fault service for lazy allocation. The fault is a
+// lazy heap access when the address is inside the recorded size but
+// the page was never mapped; this also covers faults taken in kernel
+// mode while copying to or from such a buffer. Anything else (address
+// at or beyond sz, or a present page faulting, e.g. the stack guard
+// page) is a genuine fault and returns -1.
+int
+lazyfault(void)
+{
+  struct proc *p = myproc();
+  uint va;
+  pte_t *pte;
+
+  if(p == 0)
+    return -1;
+  va = rcr2();
+  if(va >= p->sz)
+    return -1;
+  pte = walkpgdir(p->pgdir, (char*)va, 0);
+  if(pte != 0 && (*pte & PTE_P))
+    return -1;
+  return lazyalloc(p->pgdir, va);
+}
