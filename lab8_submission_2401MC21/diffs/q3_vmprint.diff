       n++;
   return n;
 }
+
+// Lab 8, Q3: dump the calling process's page tables to the console.
+// User mappings (below KERNBASE) are listed entry by entry with
+// indentation for the two levels; kernel page directory entries are
+// only counted. The closing summary lets the reader check the number
+// of user accessible (PTE_U) pages against sz / PGSIZE and spot the
+// stack guard page exec() installs (mapped, PTE_U clear).
+int
+vmprint(void)
+{
+  struct proc *p = myproc();
+  pde_t *pgdir = p->pgdir;
+  pte_t *pgtab;
+  int i, j;
+  int kernelpds = 0;
+  int userpages = 0;
+  int guarded = 0;
+
+  cprintf("vmprint: pid %d sz %d bytes (%d pages)\n",
+          p->pid, p->sz, p->sz / PGSIZE);
+  for(i = 0; i < NPDENTRIES; i++){
+    if((pgdir[i] & PTE_P) == 0)
+      continue;
+    if(i >= PDX(KERNBASE)){
+      kernelpds++;
+      continue;
+    }
+    cprintf("  PDE %d: page table pa 0x%x flags P=%d W=%d U=%d\n",
+            i, PTE_ADDR(pgdir[i]),
+            (pgdir[i] & PTE_P) != 0, (pgdir[i] & PTE_W) != 0,
+            (pgdir[i] & PTE_U) != 0);
+    pgtab = (pte_t*)P2V(PTE_ADDR(pgdir[i]));
+    for(j = 0; j < NPTENTRIES; j++){
+      if((pgtab[j] & PTE_P) == 0)
+        continue;
+      cprintf("    PTE %d: va 0x%x pa 0x%x flags P=%d W=%d U=%d\n",
+              j, PGADDR(i, j, 0), PTE_ADDR(pgtab[j]),
+              (pgtab[j] & PTE_P) != 0, (pgtab[j] & PTE_W) != 0,
+              (pgtab[j] & PTE_U) != 0);
+      if(pgtab[j] & PTE_U)
+        userpages++;
+      else
+        guarded++;
+    }
+  }
+  cprintf("vmprint: %d kernel page directory entries (>= KERNBASE) not shown\n",
+          kernelpds);
+  cprintf("vmprint: user accessible pages %d, mapped without U %d, sz/PGSIZE %d\n",
+          userpages, guarded, p->sz / PGSIZE);
+  return 0;
+}
diff --git a/vmprinttest.c b/vmprinttest.c
new file mode 100644
index 0000000..77ec978
--- /dev/null
+++ b/vmprinttest.c
@@ -0,0 +1,40 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+// Q3 (Lab 8): dump the page table at start-up, after growing the heap
+// by 8 pages, and after shrinking it by one page. New PTEs should show
+// up in the second dump and the top heap PTE should be gone in the
+// third. The mapped page with U=0 just below the stack page is the
+// guard page exec() installs; user accessible pages should therefore
+// be sz/PGSIZE - 1 in every dump.
+
+int
+main(void)
+{
+  char *base;
+  int i;
+
+  printf(1, "vmprinttest: dump at start, sz %d bytes\n", (int)sbrk(0));
+  vmprint();
+
+  base = sbrk(8 * 4096);
+  if(base == (char*)-1){
+    printf(1, "vmprinttest: sbrk failed\n");
+    exit();
+  }
+  for(i = 0; i < 8; i++)
+    base[i * 4096] = (char)i;
+  printf(1, "vmprinttest: dump after sbrk(8 pages) and touch, sz %d bytes\n",
+         (int)sbrk(0));
+  vmprint();
+
+  if(sbrk(-4096) == (char*)-1){
+    printf(1, "vmprinttest: sbrk(-4096) failed\n");
+    exit();
+  }
+  printf(1, "vmprinttest: dump after sbrk(-1 page), sz %d bytes\n",
+         (int)sbrk(0));
+  vmprint();
+  exit();
+}
