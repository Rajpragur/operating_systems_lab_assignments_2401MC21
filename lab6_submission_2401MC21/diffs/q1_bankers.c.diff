--- /dev/null
+++ bankers.c
@@ -0,0 +1,27 @@
+#ifdef HOST_TEST
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define xv6_exit() exit(0)
+#define PRINTF(...) printf(__VA_ARGS__)
+#else
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+#define xv6_exit() exit()
+#define PRINTF(...) printf(1,__VA_ARGS__)
+#endif
+
+#define N 5
+#define M 3
+static int allocation[N][M]={{0,1,0},{2,0,0},{3,0,2},{2,1,1},{0,0,2}};
+static int maximum[N][M]={{7,5,3},{3,2,2},{9,0,2},{2,2,2},{4,3,3}};
+static int available[M]={3,3,2};
+static int need[N][M];
+
+static void compute_need(void){int i,j;for(i=0;i<N;i++)for(j=0;j<M;j++)need[i][j]=maximum[i][j]-allocation[i][j];}
+static int leq(int *a,int *b){return a[0]<=b[0]&&a[1]<=b[1]&&a[2]<=b[2];}
+static int safe(int *sequence){int work[M],finish[N],i,j,count=0,changed;for(j=0;j<M;j++)work[j]=available[j];for(i=0;i<N;i++)finish[i]=0;do{changed=0;for(i=0;i<N;i++)if(!finish[i]&&leq(need[i],work)){for(j=0;j<M;j++)work[j]+=allocation[i][j];finish[i]=1;sequence[count++]=i;changed=1;}}while(changed);return count==N;}
+static void printseq(int *s){int i;PRINTF("Safe sequence: ");for(i=0;i<N;i++)PRINTF("P%d%s",s[i],i==N-1?"\n":" -> ");}
+static int request(int p,int *r){int olda[M],oldv[M],j,s[N];for(j=0;j<M;j++){if(r[j]>need[p][j]){PRINTF("Request rejected: exceeds Need[P%d]\n",p);return 0;}if(r[j]>available[j]){PRINTF("Request rejected: exceeds Available\n");return 0;}olda[j]=allocation[p][j];oldv[j]=available[j];allocation[p][j]+=r[j];available[j]-=r[j];}compute_need();if(safe(s)){PRINTF("Request granted for P%d: [%d %d %d]\n",p,r[0],r[1],r[2]);printseq(s);return 1;}for(j=0;j<M;j++){allocation[p][j]=olda[j];available[j]=oldv[j];}compute_need();PRINTF("Request denied — would lead to unsafe state\n");return 0;}
+int main(int argc,char **argv){int s[N],r1[M]={1,0,2},r2[M]={0,0,2};(void)argc;(void)argv;compute_need();PRINTF("Banker's Algorithm (N=%d, M=%d)\n",N,M);if(safe(s))printseq(s);else PRINTF("Initial state is unsafe\n");request(0,r2);request(1,r1);xv6_exit();return 0;}
