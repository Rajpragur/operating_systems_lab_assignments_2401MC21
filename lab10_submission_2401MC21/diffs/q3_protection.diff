diff --git a/sysproc.c b/sysproc.c
index 2c58f3c..400fe25 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -120,3 +120,41 @@ sys_vtop(void)
     return -1;
   return (int)(PTE_ADDR(*pte) | ((uint)va & (PGSIZE - 1)));
 }
+
+
+// Lab 10 Q3: report the frame and P/W/U flags of a mapped user address.
+int
+sys_pageinfo(void)
+{
+  int va;
+  pte_t *pte;
+  struct proc *p = myproc();
+
+  if(argint(0, &va) < 0 || (uint)va >= p->sz)
+    return -1;
+  pte = walkpgdir(p->pgdir, (void*)va, 0);
+  if(pte == 0 || (*pte & PTE_P) == 0 || (*pte & PTE_U) == 0)
+    return -1;
+  cprintf("pageinfo: va 0x%x frame 0x%x flags P=%d W=%d U=%d\n",
+          va, PTE_ADDR(*pte) / PGSIZE,
+          (*pte & PTE_P) != 0, (*pte & PTE_W) != 0, (*pte & PTE_U) != 0);
+  return 0;
+}
+
+// Lab 10 Q3: clear write permission in the current process and flush its TLB.
+int
+sys_setreadonly(void)
+{
+  int va;
+  pte_t *pte;
+  struct proc *p = myproc();
+
+  if(argint(0, &va) < 0 || (uint)va >= p->sz)
+    return -1;
+  pte = walkpgdir(p->pgdir, (void*)va, 0);
+  if(pte == 0 || (*pte & PTE_P) == 0 || (*pte & PTE_U) == 0)
+    return -1;
+  *pte &= ~PTE_W;
+  lcr3(V2P(p->pgdir));
+  return 0;
+}
