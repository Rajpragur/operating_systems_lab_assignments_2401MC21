@@ -102,3 +102,21 @@ sys_memstats(void)
           allocated, freed, allocated - freed, available);
   return 0;
 }
+
+
+// Lab 10 Q2: translate a present user virtual address through walkpgdir.
+// The result preserves the page offset; -1 marks invalid or unmapped input.
+int
+sys_vtop(void)
+{
+  int va;
+  pte_t *pte;
+  struct proc *p = myproc();
+
+  if(argint(0, &va) < 0 || (uint)va >= p->sz)
+    return -1;
+  pte = walkpgdir(p->pgdir, (void*)va, 0);
+  if(pte == 0 || (*pte & PTE_P) == 0 || (*pte & PTE_U) == 0)
+    return -1;
+  return (int)(PTE_ADDR(*pte) | ((uint)va & (PGSIZE - 1)));
+}
