diff --git a/kalloc.c b/kalloc.c
index 14cd4f4..0cf447a 100644
--- a/kalloc.c
+++ b/kalloc.c
@@ -21,6 +21,9 @@ struct {
   struct spinlock lock;
   int use_lock;
   struct run *freelist;
+  int freecount;     // Lab 10 Q1: pages currently available on the free list
+  int allocated;     // Lab 10 Q1: successful runtime page allocations
+  int freed;         // Lab 10 Q1: runtime page frees
 } kmem;
 
 // Initialization happens in two phases.
@@ -72,6 +75,9 @@ kfree(char *v)
   r = (struct run*)v;
   r->next = kmem.freelist;
   kmem.freelist = r;
+  kmem.freecount++;
+  if(kmem.use_lock)
+    kmem.freed++;
   if(kmem.use_lock)
     release(&kmem.lock);
 }
@@ -87,10 +93,30 @@ kalloc(void)
   if(kmem.use_lock)
     acquire(&kmem.lock);
   r = kmem.freelist;
-  if(r)
+  if(r){
     kmem.freelist = r->next;
+    kmem.freecount--;
+    if(kmem.use_lock)
+      kmem.allocated++;
+  }
   if(kmem.use_lock)
     release(&kmem.lock);
   return (char*)r;
 }
 
+
+
+// Lab 10 Q1: take a consistent snapshot of runtime allocation totals and
+// the free-list count. Boot-time kfree calls seed the list but are excluded
+// from the runtime allocated/freed totals.
+void
+getpagestats(int *allocated, int *freed, int *available)
+{
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  *allocated = kmem.allocated;
+  *freed = kmem.freed;
+  *available = kmem.freecount;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+}
diff --git a/memtest.c b/memtest.c
new file mode 100644
index 0000000..3cb09a0
--- /dev/null
+++ b/memtest.c
@@ -0,0 +1,30 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+// Lab 10 Q1: force heap pages to be allocated, then release them.
+int
+main(void)
+{
+  char *p;
+  int i;
+
+  printf(1, "memtest: allocator statistics in pages\n");
+  memstats();
+  p = sbrk(8 * 4096);
+  if(p == (char*)-1){
+    printf(1, "memtest: sbrk failed\n");
+    exit();
+  }
+  for(i = 0; i < 8; i++)
+    p[i * 4096] = i;
+  printf(1, "after allocating and touching 8 pages\n");
+  memstats();
+  if(sbrk(-8 * 4096) == (char*)-1){
+    printf(1, "memtest: release failed\n");
+    exit();
+  }
+  printf(1, "after releasing 8 pages\n");
+  memstats();
+  exit();
+}
