diff --git a/sysproc.c b/sysproc.c
index 0686d29..73b2cdc 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,16 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+
+// Lab 10 Q1: print allocator totals in 4 KB pages.
+int
+sys_memstats(void)
+{
+  int allocated, freed, available;
+
+  getpagestats(&allocated, &freed, &available);
+  cprintf("memstats: allocated %d freed %d current %d available %d pages\n",
+          allocated, freed, allocated - freed, available);
+  return 0;
+}
